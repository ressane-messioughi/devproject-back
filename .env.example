# /Database
# =================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# /Cloudinary
# =================================

CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# /Envoi d emails
# =================================
# Sans SMTP_HOST ni SMTP_USER, rien n est envoye : les messages sont ecrits dans
# la console du serveur. Le lien de confirmation ou de reinitialisation y reste
# lisible, ce qui permet de developper sans compte d envoi.
#
# Port 587 : connexion en clair puis passage en TLS (STARTTLS), le cas courant.
# Port 465 : connexion chiffree d emblee.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nom lisible + adresse, tels qu ils apparaissent dans la boite de reception.
SMTP_FROM="DevProject" <no-reply@devproject.ressane.fr>

# Adresse publique du site. Elle sert a fabriquer les liens des emails et a
# pointer le logo : un email ne peut pas afficher une image locale.
APP_URL=https://devproject.ressane.fr

# /GitHub
# =================================
# Optionnel : sans jeton l API GitHub repond quand meme sur les depots publics,
# mais limite a 60 appels par heure et par adresse IP.
GITHUB_TOKEN=
